# Copy to .env and load it (`set -a; source .env; set +a`) before running, or export these in your shell.
# Everything is optional: the app runs with none of them set.

# --- Django ---------------------------------------------------------------------------------------------------
# DJANGO_SECRET_KEY="change-me"          # set this if you expose the app beyond localhost
# DJANGO_DEBUG=1                          # 0 to disable debug mode
# DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost"

# --- Where the data lives ------------------------------------------------------------------------------------
# JOBHUNT_DB=/path/to/jobhunt.db          # default: jobhunt/output/jobhunt.db
# JOBHUNTER_DJANGO_DB=/path/to/django.sqlite3

# --- Google Sheets sync (optional) ---------------------------------------------------------------------------
# SHEET_ID="your-google-sheet-id"
# GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/jobhunt/service_account.json"

# --- AI features (all optional; local Ollama needs no key) ----------------------------------------------------
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="llama3.1:8b"
# ANTHROPIC_API_KEY="sk-ant-..."          # only for the Anthropic API backend

# --- Extra job sources (optional) ------------------------------------------------------------------------------
# JOOBLE_API_KEY="..."                    # free key at https://jooble.org/api/about
